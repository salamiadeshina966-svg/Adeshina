<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Adeshina – Food and water delivery</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=DM+Sans:wght@400;500;700&display=swap">
<style>
:root{--bg:#F1F6F9;--surface:#FFFFFF;--ink:#0E2A3B;--muted:#56707F;--line:#D5E2EA;--water:#1766D1;--water-soft:#DCEAFB;--food:#C77A00;--food-soft:#FFEBC7;--ok:#17805A;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0B1A24;--surface:#12293A;--ink:#E8F1F6;--muted:#93AABA;--line:#244257;--water:#5AA2FF;--water-soft:#17324F;--food:#FFB938;--food-soft:#3A2B0C;--ok:#4CC794;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0B1A24;--surface:#12293A;--ink:#E8F1F6;--muted:#93AABA;--line:#244257;--water:#5AA2FF;--water-soft:#17324F;--food:#FFB938;--food-soft:#3A2B0C;--ok:#4CC794;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 "DM Sans",system-ui,sans-serif;padding-bottom:110px}
h1,h2,h3{font-family:"Bricolage Grotesque","DM Sans",system-ui,sans-serif;margin:0;line-height:1.1}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--water);outline-offset:2px}
.wrap{max-width:680px;margin:0 auto;padding:0 16px}
header{padding:28px 0 18px}
header h1{font-size:34px;font-weight:800;letter-spacing:-.02em}
header p{margin:6px 0 0;color:var(--muted)}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:6px 0 18px}
.tab{border:2px solid var(--line);background:var(--surface);border-radius:14px;padding:14px;text-align:left}
.tab b{display:block;font:800 20px "Bricolage Grotesque",sans-serif}
.tab span{color:var(--muted);font-size:14px}
.tab[aria-selected="true"].water{border-color:var(--water);background:var(--water-soft)}
.tab[aria-selected="true"].food{border-color:var(--food);background:var(--food-soft)}
.list{display:grid;gap:10px}
.item{display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.ico{font-size:34px;width:56px;height:56px;display:grid;place-items:center;border-radius:12px}
.water .ico,.ico.water{background:var(--water-soft)}
.ico.food{background:var(--food-soft)}
.ico img{width:100%;height:100%;object-fit:cover;border-radius:12px;display:block}
.item.food{grid-template-columns:88px 1fr auto}
.item.food .ico{width:88px;height:88px}
.item.water{grid-template-columns:76px 1fr auto}
.item.water .ico{width:76px;height:114px}
.item h3{font-size:18px;font-weight:600}
.item p{margin:2px 0 4px;color:var(--muted);font-size:14px}
.price{font-weight:700}
.add{border:0;border-radius:10px;padding:10px 16px;font-weight:700;color:#fff;background:var(--water);min-width:76px}
.add.food{background:var(--food);color:#fff}
:root[data-theme="dark"] .add.food{color:#1b1200}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .add.food{color:#1b1200}.add{color:#06223f}}
:root[data-theme="dark"] .add{color:#06223f}
.qty{display:inline-flex;align-items:center;gap:4px;border:2px solid var(--line);border-radius:10px;overflow:hidden}
.qty button{border:0;background:transparent;width:36px;height:36px;font-size:20px;font-weight:700}
.qty span{min-width:22px;text-align:center;font-weight:700}
.bar{position:fixed;left:0;right:0;bottom:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));background:var(--surface);border-top:1px solid var(--line)}
.bar button{display:flex;justify-content:space-between;width:100%;max-width:648px;margin:0 auto;border:0;border-radius:14px;padding:16px 18px;background:var(--ink);color:var(--bg);font-weight:700;font-size:17px}
.bar button[disabled]{opacity:.45;cursor:not-allowed}
.sheet{position:fixed;inset:0;background:rgba(5,15,22,.55);display:none;align-items:flex-end;justify-content:center;z-index:20}
.sheet.open{display:flex}
.panel{width:100%;max-width:680px;max-height:92%;overflow:auto;background:var(--bg);border-radius:22px 22px 0 0;padding:20px 16px calc(20px + env(safe-area-inset-bottom,0px))}
.panel h2{font-size:26px;margin-bottom:12px}
.line{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.line small{color:var(--muted);display:block}
.sum{display:grid;gap:4px;margin:14px 0}
.sum div{display:flex;justify-content:space-between;color:var(--muted)}
.sum .tot{color:var(--ink);font-weight:700;font-size:19px}
label{display:block;font-weight:500;margin:12px 0 4px}
input{width:100%;padding:12px;border-radius:10px;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:inherit}
.err{color:#C0392B;font-size:14px;min-height:20px;margin:6px 0 0}
:root[data-theme="dark"] .err{color:#FF8A7A}
.btn{width:100%;margin-top:10px;border:0;border-radius:12px;padding:15px;font-weight:700;font-size:17px;background:var(--water);color:#fff}
:root[data-theme="dark"] .btn{color:#06223f}
.ghost{background:transparent;color:var(--muted);border:2px solid var(--line)}
.steps{list-style:none;margin:16px 0;padding:0;display:grid;gap:10px}
.steps li{display:flex;align-items:center;gap:12px;color:var(--muted)}
.steps i{width:26px;height:26px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-style:normal;font-size:14px}
.steps li.done{color:var(--ink)}
.steps li.done i{background:var(--ok);border-color:var(--ok);color:#fff}
.steps li.now i{border-color:var(--water);box-shadow:0 0 0 4px var(--water-soft)}
.steps li.now{color:var(--ink);font-weight:700}
.empty{color:var(--muted);padding:24px 0;text-align:center}
@media (prefers-reduced-motion:no-preference){.sheet.open .panel{animation:up .22s ease-out}@keyframes up{from{transform:translateY(40px);opacity:.4}}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Adeshina</h1>
    <p>Hot meals and clean water, delivered to your door.</p>
  </header>
  <div class="tabs" role="tablist">
    <button class="tab water" role="tab" id="t-water" aria-selected="true"><b>💧 Water</b><span>Jugs, bottles, refills</span></button>
    <button class="tab food" role="tab" id="t-food" aria-selected="false"><b>🍲 Food</b><span>Meals, ready in 30 min</span></button>
  </div>
  <div class="list" id="list"></div>
</div>

<div class="bar"><button id="cartBtn" disabled><span id="cartCount">Your cart is empty</span><span id="cartTotal"></span></button></div>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Your order"><div class="panel" id="panel"></div></div>

<script>
const CUR = "$";
const FEE = 2.5;
const ITEMS = [
  {id:"w1",cat:"water",icon:"💧",img:"data:image/jpeg;base64,",name:"Drinking water, 750 ml",desc:"Sealed bottle, easy to carry",price:0.8},
  {id:"w2",cat:"water",icon:"💧",img:"data:image/jpeg;base64,",name:"Vapor distilled water, 1 L",desc:"Purified, with electrolytes for taste",price:2},
  {id:"w3",cat:"water",icon:"💧",img:"data:image/jpeg;base64,",name:"Natural mineral water, 500 ml",desc:"Balanced pH, crisp and clean taste",price:1},
  {id:"w4",cat:"water",icon:"💧",img:"data:image/jpeg;base64,",name:"Still water, 500 ml",desc:"Light bottle, great for on the go",price:0.7},
  {id:"f1",cat:"food",icon:"🍗",img:"data:image/jpeg;base64,",name:"Fried rice, grilled chicken and coleslaw",desc:"Veggie fried rice, smoky chicken, creamy slaw",price:8.5},
  {id:"f2",cat:"food",icon:"🍛",img:"data:image/jpeg;base64,",name:"Jollof rice, chicken and plantain",desc:"Party jollof, grilled chicken, fried plantain, salad",price:9},
  {id:"f3",cat:"food",icon:"🍚",img:"data:image/jpeg;base64,",name:"White rice and tomato stew",desc:"Steamed rice with rich fish tomato stew and juice",price:7},
  {id:"f4",cat:"food",icon:"🍲",img:"data:image/jpeg;base64,",name:"Pounded yam and vegetable soup",desc:"Soft pounded yam with rich leafy soup and fish",price:9.5}
];
const cart = {};
let tab = "water", order = null, timer = null;
const $ = s => document.querySelector(s);
const money = n => CUR + n.toFixed(2);
const count = () => Object.values(cart).reduce((a,b)=>a+b,0);
const sub = () => Object.entries(cart).reduce((a,[id,q])=>a+ITEMS.find(i=>i.id===id).price*q,0);

function renderList(){
  const rows = ITEMS.filter(i=>i.cat===tab).map(i=>{
    const q = cart[i.id]||0;
    const ctl = q
      ? `<div class="qty"><button data-m="${i.id}" aria-label="Remove one ${i.name}">−</button><span>${q}</span><button data-p="${i.id}" aria-label="Add one ${i.name}">+</button></div>`
      : `<button class="add ${i.cat}" data-p="${i.id}">Add</button>`;
    return `<div class="item ${i.cat}"><div class="ico ${i.cat}">${i.img?`<img src="${i.img}" alt="${i.name}">`:i.icon}</div><div><h3>${i.name}</h3><p>${i.desc}</p><span class="price">${money(i.price)}</span></div>${ctl}</div>`;
  }).join("");
  $("#list").innerHTML = rows;
}
function renderBar(){
  const c = count(), b = $("#cartBtn");
  b.disabled = !c;
  $("#cartCount").textContent = c ? `View cart · ${c} item${c>1?"s":""}` : "Your cart is empty";
  $("#cartTotal").textContent = c ? money(sub()) : "";
}
function change(id,d){
  cart[id] = Math.max(0,(cart[id]||0)+d);
  if(!cart[id]) delete cart[id];
  renderList(); renderBar();
  if($("#sheet").classList.contains("open") && !order) renderCart();
}
function setTab(t){
  tab = t;
  $("#t-water").setAttribute("aria-selected", t==="water");
  $("#t-food").setAttribute("aria-selected", t==="food");
  renderList();
}
function renderCart(){
  if(!count()){ closeSheet(); return; }
  const lines = Object.entries(cart).map(([id,q])=>{
    const i = ITEMS.find(x=>x.id===id);
    return `<div class="line"><div>${i.icon} ${i.name}<small>${money(i.price)} each</small></div><div class="qty"><button data-m="${id}" aria-label="Remove one">−</button><span>${q}</span><button data-p="${id}" aria-label="Add one">+</button></div></div>`;
  }).join("");
  $("#panel").innerHTML = `<h2>Your order</h2>${lines}
  <div class="sum"><div><span>Items</span><span>${money(sub())}</span></div><div><span>Delivery</span><span>${money(FEE)}</span></div><div class="tot"><span>Total</span><span>${money(sub()+FEE)}</span></div></div>
  <label for="nm">Your name</label><input id="nm" autocomplete="name">
  <label for="ph">Phone number</label><input id="ph" type="tel" autocomplete="tel">
  <label for="ad">Delivery address</label><input id="ad" autocomplete="street-address">
  <p class="err" id="err" role="alert"></p>
  <button class="btn" id="place">Place order · ${money(sub()+FEE)}</button>
  <button class="btn ghost" id="close">Keep shopping</button>`;
}
function renderTrack(){
  const names = ["Order confirmed","Preparing your items","On the way","Delivered"];
  const lis = names.map((n,i)=>`<li class="${i<order.step?"done":i===order.step?"now":""}"><i>${i<order.step?"✓":""}</i>${n}</li>`).join("");
  const done = order.step>=3;
  $("#panel").innerHTML = `<h2>${done?"Delivered. Enjoy!":"Order #"+order.no}</h2>
  <p style="color:var(--muted);margin:0">${done?"Thanks, "+order.name+".":"Delivering to "+order.addr}</p>
  <ul class="steps">${lis}</ul>
  <button class="btn" id="again">${done?"Order again":"Back to menu"}</button>`;
}
function openSheet(){ $("#sheet").classList.add("open"); order?renderTrack():renderCart(); }
function closeSheet(){ $("#sheet").classList.remove("open"); }
function place(){
  const name=$("#nm").value.trim(), ph=$("#ph").value.trim(), ad=$("#ad").value.trim();
  if(!name||!ph||!ad){ $("#err").textContent="Please fill in your name, phone number and address."; return; }
  order = {no:Math.floor(1000+Math.random()*9000), name, addr:ad, step:0};
  for(const k in cart) delete cart[k];
  renderList(); renderBar(); renderTrack();
  timer = setInterval(()=>{
    order.step++;
    if($("#sheet").classList.contains("open")) renderTrack();
    if(order.step>=3) clearInterval(timer);
  }, 4000);
}
document.addEventListener("click",e=>{
  const t = e.target.closest("button"); if(!t) return;
  if(t.dataset.p) change(t.dataset.p,1);
  else if(t.dataset.m) change(t.dataset.m,-1);
  else if(t.id==="t-water") setTab("water");
  else if(t.id==="t-food") setTab("food");
  else if(t.id==="cartBtn") openSheet();
  else if(t.id==="place") place();
  else if(t.id==="close") closeSheet();
  else if(t.id==="again"){ clearInterval(timer); order=null; closeSheet(); }
});
$("#sheet").addEventListener("click",e=>{ if(e.target.id==="sheet") closeSheet(); });
document.addEventListener("keydown",e=>{ if(e.key==="Escape") closeSheet(); });
renderList(); renderBar();
</script>
</body>
</html>
